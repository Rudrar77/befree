# Flask configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_CONFIG=development

# Security
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///instance/bankstatements.db

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# File retention
FILE_RETENTION_DAYS=90

# OCR settings
OCR_DPI=300
TEXT_MIN_CHARS_PER_PAGE=50
# Install the configured Paddle provider (includes paddlex[ocr] for PP-StructureV3):
# python -m pip install -r requirements-ocr-paddle.txt
OCR_PROVIDER=paddleocr
OCR_FALLBACK_PROVIDER=tesseract
OCR_SECONDARY_PROVIDER=
OCR_USE_GPU=false
MAX_DOCUMENT_PAGES=500
OCR_IMAGE_COVERAGE_THRESHOLD=0.20
PADDLE_TEXT_DETECTION_MODEL=PP-OCRv4_mobile_det
PADDLE_TEXT_RECOGNITION_MODEL=en_PP-OCRv4_mobile_rec
PADDLE_LAYOUT_MODEL=PP-DocLayout_plus-L
PADDLE_TABLE_MODEL=SLANet_plus
PADDLE_WIRED_TABLE_MODEL=SLANet_plus
PADDLE_WIRELESS_TABLE_MODEL=SLANet_plus
PADDLE_USE_DOC_ORIENTATION=false
PADDLE_USE_UNWARPING=false
PADDLE_USE_TEXTLINE_ORIENTATION=false
PADDLE_USE_REGION_DETECTION=false

# Optional cloud providers (used only when explicitly selected)
# Azure: OCR_PROVIDER=azure
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Google: OCR_PROVIDER=google
# GOOGLE_DOCUMENTAI_PROCESSOR_NAME=projects/PROJECT/locations/LOCATION/processors/PROCESSOR
# AWS: OCR_PROVIDER=textract
# AWS_REGION=

# Processing thresholds
CONFIDENCE_THRESHOLD=0.6
RECONCILIATION_TOLERANCE=0.50

# Background processing
STALE_JOB_MINUTES=30
WORKER_THREADS=2

# CORS
CORS_ORIGINS=http://localhost:5000

# ML model
MODEL_PATH=models/classifier.pkl
PRETRAINED_TRANSACTION_MODEL_PATH=app/data/transaction_classifier_v3.joblib
PRETRAINED_TRANSACTION_MODEL_SHA256=63f7cffc114dd72572374db6f17f88aa35219b8514335263d1ded1fe62a31fd6
PRETRAINED_TRANSACTION_CONFIDENCE_THRESHOLD=0.30

# Logging
LOG_LEVEL=DEBUG
